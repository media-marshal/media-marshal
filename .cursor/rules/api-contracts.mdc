```typescript
interface BrowseResult {
  currentPath: string         // 当前路径（已规范化，斜杠统一；Windows 盘符示例 D:/）
  parentPath: string | null   // 父目录路径，根目录时为 null；Windows 盘符根目录的父级为 /
  dirs: Array<{
    name: string              // 目录名
    path: string              // 完整绝对路径
  }>
}
